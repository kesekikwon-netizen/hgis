{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "3600000",
    "MCP_TIMEOUT": "30000",
    "MCP_TOOL_TIMEOUT": "180000"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(rg:*)",
      "Bash(python scripts/clangd-definition.py:*)",
      "Bash(py scripts/clangd-definition.py:*)",
      "Bash(python scripts/secret-scan.py:*)",
      "Bash(node --test scripts/graft-mcp.test.mjs)",
      "Bash(node scripts/graft-mcp.mjs --index)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-now.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/archify.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/gen-compile-commands.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/clang-tidy-changed.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-ka-hgis.ps1 --smoke-quit)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command . .\\scripts\\dev-env.ps1; ctest:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command . .\\scripts\\dev-env.ps1; cmake --build:*)",
      "Bash(ctest:*)",
      "Bash(cmake --build:*)",
      "Bash(clang-format --dry-run:*)",
      "mcp__hgis_graft",
      "mcp__microsoft-learn",
      "WebFetch(domain:doc.qt.io)",
      "WebFetch(domain:qgis.org)",
      "WebFetch(domain:api.qgis.org)",
      "WebFetch(domain:docs.qgis.org)",
      "WebFetch(domain:gdal.org)",
      "WebFetch(domain:proj.org)",
      "WebFetch(domain:en.cppreference.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:cmake.org)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publish-desktop.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/make-portable.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sign-release.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-deps.ps1:*)",
      "Edit(docs/COMMIT_STATUS.md)",
      "Edit(.agents/skills/archify/**)",
      "Edit(dev-env.lock.json)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(./config/secrets.ini)",
      "Read(./.env)",
      "Read(~/AppData/Local/ka-hgis/**)",
      "Edit(~/AppData/Local/ka-hgis/**)",
      "Edit(./config/secrets.ini)"
    ]
  },
  "enabledMcpjsonServers": ["hgis_graft", "microsoft-learn"],
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dev-loop.mjs\" sessionStart", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" pre", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dev-loop.mjs\" postEdit", "timeout": 15 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" post", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dev-loop.mjs\" postShell", "timeout": 15 }
        ]
      },
      {
        "matcher": "mcp__hgis_graft__.*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dev-loop.mjs\" postMcp", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dev-loop.mjs\" stop", "timeout": 15 }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/statusline.mjs\""
  }
}
