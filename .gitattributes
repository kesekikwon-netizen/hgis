# 저장소에는 LF 로 저장하고, 체크아웃할 때 OS 규칙을 따른다.
* text=auto

# 바이너리로 다뤄 diff/merge 에서 깨지지 않게 한다.
*.png binary
*.ico binary
*.pdf binary
*.gpkg binary
*.zip binary
*.dwg binary
*.dll binary
*.exe binary
# 받은 그대로 둔다(줄바꿈을 바꾸지 않아 COPYING 의 sha256 이 유지된다).
third_party/** -text

# Cloud agent scripts run on Ubuntu and must stay LF.
.cursor/Dockerfile text eol=lf
.cursor/cloud-install.sh text eol=lf
.cursor/hooks/dev-loop.mjs text eol=lf
*.qgz binary
